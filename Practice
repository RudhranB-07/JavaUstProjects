for q in ["What is overfitting?", "How does k-nearest neighbors make a prediction?"]:
    print("\nQuery:", q)
    for k in [3, 5, 7]:
        docs = retrieve(q, k)
        print(f"  k={k}: pages {[d['page'] for d in docs]}, lowest score {min(d['score'] for d in docs)}")

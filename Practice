def retrieve(question, k=5):
    q = model.encode([question], normalize_embeddings=True)            # query -> embedding
    res = collection.query(query_embeddings=q.tolist(), n_results=k)   # top-k chunks
    docs = []
    for text, meta, dist in zip(res["documents"][0], res["metadatas"][0], res["distances"][0]):
        docs.append({"text": text, "page": meta["page"], "score": round(1 - dist, 3)})
    return docs

for d in retrieve("What is overfitting?", k=3):
    print(f"PDF p.{d['page']} | score {d['score']} | {d['text'][:120]!r}")
